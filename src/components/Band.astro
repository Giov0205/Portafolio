---
import { band } from "../data/portfolio";
---

<section class="band" aria-label="Formación">
  <div class="wrap band-in">
    <div>
      <h2 class="label">{band.title}</h2>
      <p>{band.text}</p>
    </div>
    <div class="stats">
      {band.stats.map((s) => (
        <div><strong>{s.value}</strong><span>{s.label}</span></div>
      ))}
    </div>
  </div>
  <span class="band-mark" aria-hidden="true">{band.mark}</span>
</section>
