---
import SectionShell from "./SectionShell.astro";
import { site, socials } from "../data/portfolio";

const isExternal = (href: string) => href.startsWith("http");
---

<SectionShell
  id="contacto"
  index="04"
  title="CONTACTO Y REDES"
  eyebrow="SECCIÓN 04 — CANAL DE COMUNICACIÓN"
  breadcrumb="TAC-COM // EXPEDIENTE 04"
>
  <div class="grid gap-8 lg:grid-cols-[1fr_320px] lg:gap-12">
    <div>
      <p class="max-w-2xl text-base leading-relaxed text-white/85 sm:text-lg">
        ¿Tienes una idea, un proyecto o una vacante? Escríbeme y coordinamos.
        Respondo normalmente en menos de 24 horas.
      </p>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
        {
          socials.map((social) => (
            <li class:list={[social.primary && "sm:col-span-2"]}>
              <a
                href={social.href}
                class:list={[
                  "social-row hud hud-corner-sm flex items-center gap-4 p-4",
                  social.primary && "border-accent/35 bg-accent/[0.06]",
                ]}
                target={isExternal(social.href) ? "_blank" : undefined}
                rel={isExternal(social.href) ? "noopener noreferrer" : undefined}
              >
                <span
                  class="flex size-10 shrink-0 items-center justify-center border border-white/12 bg-white/[0.03] text-white/80"
                  aria-hidden="true"
                >
                  {social.icon === "github" && (
                    <svg viewBox="0 0 24 24" class="size-5" fill="currentColor">
                      <path d="M12 .5C5.73.5.9 5.33.9 11.6c0 4.9 3.17 9.06 7.57 10.53.55.1.75-.24.75-.53v-2.05c-3.08.67-3.73-1.3-3.73-1.3-.5-1.29-1.23-1.63-1.23-1.63-1.01-.7.08-.68.08-.68 1.11.08 1.7 1.15 1.7 1.15 1 1.7 2.62 1.21 3.26.93.1-.72.39-1.21.71-1.49-2.46-.28-5.05-1.23-5.05-5.48 0-1.21.43-2.2 1.14-2.98-.11-.28-.49-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.5 10.5 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.6 1.53.22 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.2-5.07 5.47.4.35.76 1.03.76 2.08v3.08c0 .3.2.64.76.53a11.1 11.1 0 0 0 7.56-10.53C23.1 5.33 18.27.5 12 .5Z" />
                    </svg>
                  )}
                  {social.icon === "linkedin" && (
                    <svg viewBox="0 0 24 24" class="size-5" fill="currentColor">
                      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.07-1.9-3.07-1.9 0-2.2 1.45-2.2 2.96V21H9V9Z" />
                    </svg>
                  )}
                  {social.icon === "x" && (
                    <svg viewBox="0 0 24 24" class="size-5" fill="currentColor">
                      <path d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.4L6.2 22H3l7.3-8.3L2 2h6.4l4.5 5.9L18.9 2Zm-1.1 18h1.7L7.1 3.8H5.3L17.8 20Z" />
                    </svg>
                  )}
                  {social.icon === "mail" && (
                    <svg
                      viewBox="0 0 24 24"
                      class="size-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="1" />
                      <path d="m3.5 6.5 8.5 6 8.5-6" />
                    </svg>
                  )}
                  {social.icon === "link" && (
                    <svg
                      viewBox="0 0 24 24"
                      class="size-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                    >
                      <path d="M10 14 21 3M14 3h7v7" />
                      <path d="M21 14v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h6" />
                    </svg>
                  )}
                </span>

                <span class="min-w-0 flex-1">
                  <span class="hud-label hud-label-accent block">{social.label}</span>
                  <span class="mt-1 block truncate text-sm font-semibold tracking-[0.08em] text-white">
                    {social.handle}
                  </span>
                </span>

                <span class="font-mono text-sm text-accent-soft" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-5 text-xs leading-relaxed text-ash">
        También puedes copiar mi correo directamente:{" "}
        <a
          class="text-white underline decoration-accent/60 decoration-2 underline-offset-4 hover:text-accent-soft"
          href={`mailto:${site.email}`}>{site.email}</a
        >
      </p>
    </div>

    <aside class="hud h-fit p-5">
      <p class="hud-label flex items-center gap-2">
        <span class="status-dot" aria-hidden="true"></span>
        ESTADO DEL CANAL
      </p>
      <p class="mt-3 font-title text-3xl uppercase leading-none text-white">
        ABIERTO
      </p>
      <p class="mt-2 text-sm leading-relaxed text-ash">
        Disponible para colaboraciones, prácticas profesionales y proyectos
        freelance.
      </p>

      <div class="mt-5 space-y-3 border-t border-dashed border-white/15 pt-4">
        <div class="flex items-center justify-between gap-3">
          <span class="hud-label">UBICACIÓN</span>
          <span class="text-xs uppercase tracking-[0.12em] text-white/85">{site.city}</span>
        </div>
        <div class="flex items-center justify-between gap-3">
          <span class="hud-label">RESPUESTA</span>
          <span class="text-xs uppercase tracking-[0.12em] text-white/85">&lt; 24 H</span>
        </div>
        <div class="flex items-center justify-between gap-3">
          <span class="hud-label">ID</span>
          <span class="text-xs uppercase tracking-[0.12em] text-white/85">{site.callsign}</span>
        </div>
      </div>

      <p class="hud-label mt-5 flex items-center gap-2 text-white/35">
        <span class="status-dot" aria-hidden="true"></span>
        {site.status}
      </p>
    </aside>
  </div>
</SectionShell>
