---
import SectionShell from "./SectionShell.astro";
import { about, site } from "../data/portfolio";
---

<SectionShell
  id="acerca"
  index="01"
  title={about.title}
  eyebrow={about.eyebrow}
  breadcrumb="SISTEMA // MÓDULO 01"
>
  <div class="grid gap-8 lg:grid-cols-[300px_1fr] lg:gap-12">
    <!-- FOTO -->
    <div class="mx-auto w-full max-w-[320px] lg:mx-0">
      <div class="hud p-2">
        <div class="relative overflow-hidden bg-carbon">
          <img
            src={site.photo}
            alt={`Retrato de ${site.name}`}
            width="600"
            height="720"
            class="aspect-[5/6] w-full object-cover grayscale-[35%]"
            loading="eager"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/80 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>
          <span
            class="absolute left-3 top-3 border border-accent/50 bg-void/70 px-2 py-1 font-mono text-[9px] tracking-[0.2em] text-white/80"
            >ID · {site.callsign}</span
          >
          <span
            class="absolute bottom-3 right-3 font-mono text-[9px] tracking-[0.2em] text-white/55"
            >PERFIL</span
          >
        </div>
      </div>
      <p class="hud-label mt-3 text-center text-white/35">
        REGISTRO VISUAL // 01
      </p>
    </div>

    <!-- TEXTO -->
    <div class="flex flex-col gap-6">
      <p class="text-lg leading-relaxed text-white/90 sm:text-xl">
        {about.intro}
      </p>

      <div class="space-y-3 text-sm leading-relaxed text-ash sm:text-base">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <!-- FORMACIÓN -->
      <div class="hud hud-corner-sm p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="hud-label hud-label-accent">{about.school.label}</p>
          <span class="chip">{about.school.period}</span>
        </div>
        <p class="mt-3 text-lg font-semibold uppercase tracking-[0.08em] text-white">
          {about.school.name}
        </p>
        <p class="mt-1 text-sm text-ash">{about.school.place}</p>
      </div>

      <!-- OBJETIVOS -->
      <div>
        <p class="hud-label hud-label-accent mb-3">// OBJETIVOS</p>
        <ul class="space-y-3">
          {
            about.objectives.map((objective) => (
              <li class="note-line">
                <p class="font-mono text-[9px] tracking-[0.22em] text-accent-soft">
                  {objective.label}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-white/80">
                  {objective.text}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</SectionShell>
