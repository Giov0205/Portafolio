---
import SectionShell from "./SectionShell.astro";
import PadIcon from "./PadIcon.astro";
import { projects, site } from "../data/portfolio";

const hasLink = (value: string) => value.trim().length > 0;
---

<SectionShell
  id="proyectos"
  index="02"
  title="PROYECTOS"
  eyebrow="MÓDULO 02 — TIENDA DE PROYECTOS"
  breadcrumb="SISTEMA // MÓDULO 02"
>
  <p class="mb-10 max-w-2xl text-sm leading-relaxed text-ash sm:text-base">
    Cada proyecto es un juego en el estante. Haz clic en una caja
    <span class="inline-flex translate-y-[3px]"><PadIcon type="cross" class="pad-inline" /></span>
    para voltearla y ver la contraportada.
  </p>

  <ul class="shelf" role="list">
    {
      projects.map((project) => (
        <li class="game-slot">
          <div
            class="game-box"
            data-game-box
            data-repo={project.repo}
            data-name={project.name}
            data-flipped="false"
            style={`--box: ${project.color};`}
          >
            {/* ===== PORTADA ===== */}
            <button
              type="button"
              class="game-face game-front"
              data-flip="open"
              aria-expanded="false"
              aria-controls={`contra-${project.id}`}
              aria-label={`${project.name}. ${project.genre}. Ver contraportada`}
            >
              <span class="game-band">
                <span class="game-band-text">{site.callsign}</span>
                <span class="game-band-text">{project.year}</span>
              </span>

              <span class="game-cover">
                <img
                  src={project.image}
                  alt=""
                  width="800"
                  height="450"
                  loading="lazy"
                />
              </span>

              <span class="game-info">
                <span class="game-genre">{project.genre}</span>
                <span class="game-title">{project.name}</span>
                <span class="game-meta">
                  <span>{project.players}</span>
                  <span class="game-status">{project.status}</span>
                </span>
              </span>

              <span class="game-hint" aria-hidden="true">
                <PadIcon type="cross" class="pad-inline" />
                VOLTEAR
              </span>
            </button>

            {/* ===== CONTRAPORTADA ===== */}
            <div class="game-face game-back" id={`contra-${project.id}`} inert>
              <span class="game-band">
                <span class="game-band-text">{project.name}</span>
                <span class="game-band-text">{project.genre}</span>
              </span>

              <div class="game-back-body">
                <h3 class="font-title text-2xl uppercase leading-none tracking-wide text-white">
                  {project.name}
                </h3>
                <p class="mt-3 text-[13px] leading-relaxed text-white/80">
                  {project.description}
                </p>

                <p class="hud-label mt-4">CONTENIDO</p>
                <ul class="mt-2 flex flex-wrap gap-1.5" aria-label={`Tecnologías de ${project.name}`}>
                  {project.tech.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>
              </div>

              <div class="game-back-actions">
                {hasLink(project.repo) && (
                  <a
                    class="btn-hud btn-accent flex-1"
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-back-focus
                  >
                    <PadIcon type="triangle" class="pad-inline" />
                    CÓDIGO
                  </a>
                )}
                {hasLink(project.demo) && (
                  <a
                    class="btn-hud flex-1"
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    DEMO ↗
                  </a>
                )}
                <button
                  type="button"
                  class="btn-hud flex-1"
                  data-flip="close"
                  data-back-focus={hasLink(project.repo) ? undefined : true}
                >
                  <PadIcon type="circle" class="pad-inline" />
                  VOLTEAR
                </button>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</SectionShell>
