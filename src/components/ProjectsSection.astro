---
import SectionShell from "./SectionShell.astro";
import { projects } from "../data/portfolio";

const hasLink = (value: string) => value.trim().length > 0;
---

<SectionShell
  id="proyectos"
  index="02"
  title="PROYECTOS"
  eyebrow="SECCIÓN 02 — REGISTRO DE MISIONES"
  breadcrumb="TAC-COM // EXPEDIENTE 02"
>
  <p class="mb-8 max-w-2xl text-sm leading-relaxed text-ash sm:text-base">
    Cada tarjeta es una misión desplegada. Puedes revisar el código y, cuando
    exista, abrir la demostración en vivo.
  </p>

  <div class="grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <article class="mission-card hud flex flex-col overflow-hidden">
          <div class="mission-media relative aspect-video overflow-hidden border-b border-white/10 bg-carbon">
            <img
              src={project.image}
              alt={`Vista previa del proyecto ${project.name}`}
              width="800"
              height="450"
              class="h-full w-full object-cover"
              loading="lazy"
            />
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void via-void/20 to-transparent"
              aria-hidden="true"
            />
            <div class="absolute left-3 top-3 flex items-center gap-2">
              <span class="border border-accent/60 bg-void/80 px-2 py-1 font-mono text-[9px] tracking-[0.2em] text-accent-soft">
                {project.codename}
              </span>
            </div>
            <div class="absolute bottom-3 right-3">
              <span class="flex items-center gap-2 border border-white/15 bg-void/80 px-2 py-1 font-mono text-[9px] tracking-[0.18em] text-white/75">
                <span class="status-dot status-dot-green" aria-hidden="true"></span>
                {project.status}
              </span>
            </div>
          </div>

          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-title text-3xl uppercase leading-none tracking-wide text-white">
              {project.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ash">
              {project.description}
            </p>

            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`Tecnologías de ${project.name}`}>
              {project.tech.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>

            <div class="mt-5 flex flex-wrap gap-2 border-t border-dashed border-white/12 pt-4">
              {hasLink(project.repo) ? (
                <a
                  class="btn-hud flex-1"
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  CÓDIGO
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span
                  class="btn-hud flex-1 cursor-not-allowed opacity-45"
                  aria-disabled="true"
                  title="Agrega el enlace en src/data/portfolio.ts"
                >
                  CÓDIGO
                </span>
              )}

              {hasLink(project.demo) ? (
                <a
                  class="btn-hud btn-accent flex-1"
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  DEMO
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span
                  class="btn-hud flex-1 cursor-not-allowed opacity-45"
                  aria-disabled="true"
                  title="Agrega el enlace en src/data/portfolio.ts"
                >
                  DEMO
                </span>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</SectionShell>
