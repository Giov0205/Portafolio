---
import Icon from "./Icon.astro";
import type { Project } from "../data/portfolio";

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const many = p.photos.length > 1;
---

<li class="card" data-cat={p.category}>
  <div class="gallery" data-name={p.name}>
    <div class="shots" tabindex="-1">
      {p.photos.map((ph, i) => (
        <button
          class="shot"
          type="button"
          data-i={i}
          data-src={ph.src}
          data-caption={ph.caption}
          aria-label={`Ver foto ${i + 1} de ${p.photos.length} de ${p.name} en grande`}
        >
          <img src={ph.src} alt={ph.caption} loading="lazy" width="800" height="500" />
        </button>
      ))}
    </div>
    <span class="st">{p.status.toUpperCase()}</span>
    {many && (
      <>
        <span class="count"><span class="n">1</span> / {p.photos.length}</span>
        <button class="g-btn g-prev" type="button" aria-label="Foto anterior"><Icon name="prev" size={18} /></button>
        <button class="g-btn g-next" type="button" aria-label="Foto siguiente"><Icon name="next" size={18} /></button>
        <span class="dots" aria-hidden="true">
          {p.photos.map((_, i) => <i class={i === 0 ? "on" : ""}></i>)}
        </span>
      </>
    )}
  </div>

  <div class="card-b">
    <p class="meta">{p.area} · {p.year}</p>
    <h3>{p.name}</h3>
    <p>{p.description}</p>
    <ul class="chips" aria-label={`Tecnologías de ${p.name}`}>
      {p.tech.map((t) => <li>{t}</li>)}
    </ul>
    <div class="card-a">
      {p.play && (
        <a class="ghost" href={p.play} target="_blank" rel="noopener noreferrer">{p.playLabel ?? "Ver proyecto"}</a>
      )}
      {p.repo ? (
        <a class="ghost" href={p.repo} target="_blank" rel="noopener noreferrer">{p.repoLabel ?? "Ver código"}</a>
      ) : (
        <span class="nolink">{p.note ?? "Sin repositorio público"}</span>
      )}
    </div>
  </div>
</li>
