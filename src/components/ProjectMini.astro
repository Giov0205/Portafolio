---
import ProjectActions from "./ProjectActions.astro";
import type { Project } from "../data/portfolio";

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const cover = p.photos[0];
---

<li class="mini card" data-cat={p.category}>
  <div class="mini-th" aria-hidden="true">
    <img src={cover.src} alt="" width="264" height="165" loading="lazy" decoding="async" />
  </div>
  <div class="mini-b">
    <p class="meta">{p.area} · {p.year}</p>
    <h3>{p.name}</h3>
    <p class="sum">{p.summary}</p>
  </div>
  <ProjectActions project={p} />
</li>
