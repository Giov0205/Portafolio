---
import { menuSections, site, ui } from "../data/portfolio";
---

<aside
  class="hud flex min-h-[340px] min-w-0 flex-col p-5 sm:p-6 lg:min-h-[380px]"
  aria-label="Vista previa de la sección"
>
  <div class="flex items-center justify-between gap-3">
    <p class="hud-label flex items-center gap-2">
      <span class="status-dot status-dot-green" aria-hidden="true"></span>
      {ui.previewLabel}
    </p>
    <p class="hud-label text-white/35">{ui.previewTag}</p>
  </div>

  <div class="mt-4 flex flex-1 flex-col">
    {
      menuSections.map((section, i) => (
        <div
          id={`panel-${section.id}`}
          data-preview
          class="preview-panel relative flex flex-1 flex-col"
          hidden={i !== 0}
        >
          <span
            class="pointer-events-none absolute -right-2 top-0 font-title text-[6rem] leading-none text-white/[0.055] sm:text-[7rem]"
            aria-hidden="true"
          >
            {section.index}
          </span>

          <p class="eyebrow">MÓDULO {section.index}</p>

          <h2 class="mt-2 max-w-[85%] font-title text-[2rem] uppercase leading-[0.95] tracking-wide text-white sm:text-4xl">
            {section.title}
          </h2>

          <p class="mt-3 max-w-[46ch] text-sm leading-relaxed text-ash">
            {section.description}
          </p>

          <div class="mt-auto pt-6">
            <div class="grid grid-cols-2 gap-x-4 gap-y-3 border-t border-dashed border-white/15 pt-4">
              {section.stats.map((stat) => (
                <div class="border-l border-white/10 pl-3">
                  <p class="hud-label text-white/40">{stat.label}</p>
                  <p class="mt-1 text-sm font-semibold uppercase tracking-[0.12em] text-white/90">
                    {stat.value}
                  </p>
                </div>
              ))}
            </div>

            <div class="mt-4 flex items-center justify-between border-t border-white/10 pt-3">
              <p class="hud-label flex items-center gap-2">
                <span class="status-dot" aria-hidden="true"></span>
                {site.status}
              </p>
              <p class="hud-label text-white/30">MÓDULO // {section.index}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</aside>
