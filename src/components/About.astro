---
import BoxHead from "./BoxHead.astro";
import Divider from "./Divider.astro";
import Icon from "./Icon.astro";
import { about } from "../data/portfolio";
---

<section class="section light" id="sobre-mi">
  <div class="wrap">
    <BoxHead title="Sobre mí" />

    <div class="about">
      <div>
        <p class="lead">{about.lead}</p>
      </div>
      <div class="body">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <Divider />

    <div class="services">
      {about.services.map((s) => (
        <div class="svc">
          <span class="ic"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
