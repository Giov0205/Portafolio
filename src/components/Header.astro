---
import { site, ui } from "../data/portfolio";
---

<header class="flex flex-col gap-5">
  <div
    class="flex items-center justify-between gap-4 border-b border-white/10 pb-2"
  >
    <p class="hud-label flex items-center gap-2">
      <span class="status-dot" aria-hidden="true"></span>
      {ui.terminal}
    </p>
    <p class="hud-label hidden sm:block">
      {site.callsign} · {site.systemVersion}
    </p>
  </div>

  <div>
    <p class="eyebrow mb-2 text-accent-soft">// OPERADOR REGISTRADO</p>
    <h1
      class="name-gradient font-title uppercase leading-[0.85] tracking-[0.05em] text-[clamp(2.3rem,11vw,6.2rem)] sm:tracking-[0.08em]"
    >
      {site.name}
    </h1>

    <div class="mt-4 flex items-center gap-3 sm:gap-4">
      <span class="role-line h-[2px] w-14 shrink-0 sm:w-24" aria-hidden="true"
      ></span>
      <p
        class="font-mono text-[10px] uppercase leading-relaxed tracking-[0.24em] text-white/80 sm:text-xs sm:tracking-[0.32em]"
      >
        {site.role}
      </p>
    </div>
  </div>
</header>
