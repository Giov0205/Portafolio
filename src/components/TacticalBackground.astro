---
import { site } from "../data/portfolio";
---

<div class="fx" aria-hidden="true">
  <div
    class="fx-photo"
    style={`background-image: url('${site.backgroundImage}');`}
  >
  </div>

  <!-- Aurora: manchas de luz cian que respiran detrás de todo -->
  <div class="fx-aurora">
    <span class="fx-aurora-blob fx-aurora-a"></span>
    <span class="fx-aurora-blob fx-aurora-b"></span>
  </div>

  <!-- Neblina volumétrica que se desplaza muy lento -->
  <div class="fx-fog"></div>

  <div class="fx-tint"></div>
  <div class="fx-grid"></div>

  <!-- Pulso de señal: brillo tenue que late como telemetría -->
  <div class="fx-pulse"></div>

  <!-- Polvo en suspensión -->
  <div class="fx-dust"></div>

  <div class="fx-noise"></div>
  <div class="fx-scanlines"></div>
  <div class="fx-vignette"></div>
</div>
