---
import SectionShell from "./SectionShell.astro";
import { experience, skillGroups } from "../data/portfolio";
---

<SectionShell
  id="habilidades"
  index="03"
  title="HABILIDADES Y EXPERIENCIA"
  eyebrow="MÓDULO 03 — STACK Y TRAYECTORIA"
  breadcrumb="SISTEMA // MÓDULO 03"
>
  <div class="grid gap-6 lg:grid-cols-2">
    {
      skillGroups.map((group) => (
        <section class="hud p-5 sm:p-6" aria-labelledby={`skill-${group.name}`}>
          <div class="flex items-center justify-between gap-3 border-b border-dashed border-white/12 pb-3">
            <h3
              id={`skill-${group.name}`}
              class="font-title text-2xl uppercase leading-none tracking-wide text-white"
            >
              {group.name}
            </h3>
            <span class="hud-label text-accent-soft">{group.codename}</span>
          </div>

          <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Tecnologías de ${group.name}`}>
            {group.skills.map((skill) => (
              <li class="chip">{skill}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <div class="mt-12 grid gap-8 lg:grid-cols-[280px_1fr] lg:gap-12">
    <div>
      <p class="eyebrow">TRAYECTORIA</p>
      <h3 class="section-title mt-2 text-4xl text-white sm:text-5xl">
        EXPERIENCIA
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ash">
        Proyectos y etapas donde he puesto en práctica estas tecnologías. Cada
        entrada incluye lo que construí y con qué.
      </p>
      <div class="hud hud-corner-sm mt-5 p-4">
        <p class="hud-label flex items-center gap-2">
          <span class="status-dot" aria-hidden="true"></span>
          ESTADO: DISPONIBLE
        </p>
        <p class="mt-2 text-xs leading-relaxed text-ash">
          Abierto a prácticas profesionales y proyectos.
        </p>
      </div>
    </div>

    <div class="timeline">
      {
        experience.map((entry) => (
          <div class="timeline-item">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-mono text-[10px] tracking-[0.22em] text-accent-soft">
                {entry.period}
              </span>
              <span class="chip">{entry.tag}</span>
            </div>
            <h4 class="mt-3 text-lg font-semibold uppercase tracking-[0.08em] text-white">
              {entry.title}
            </h4>
            <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.16em] text-white/45">
              {entry.place}
            </p>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ash">
              {entry.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</SectionShell>
