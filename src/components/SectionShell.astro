---
import { site } from "../data/portfolio";

interface Props {
  id: string;
  index: string;
  title: string;
  eyebrow: string;
  breadcrumb: string;
}

const { id, index, title, eyebrow, breadcrumb } = Astro.props;
---

<section
  id={`section-${id}`}
  data-view-panel={id}
  hidden
  aria-labelledby={`title-${id}`}
  class="relative min-h-dvh"
>
  <div class="mx-auto w-full max-w-6xl px-5 pb-10 pt-6 sm:px-8 sm:pt-8 lg:pt-10">
    <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-3">
      <button type="button" class="btn-hud" data-back>
        <span aria-hidden="true">&lt;</span>
        REGRESAR
      </button>
      <p class="hud-label hidden items-center gap-2 sm:flex">
        <span class="status-dot status-dot-green" aria-hidden="true"></span>
        {breadcrumb}
      </p>
    </div>

    <div class="mt-8 sm:mt-10">
      <p class="eyebrow">{eyebrow}</p>
      <div class="mt-2 flex items-end gap-4">
        <span
          class="font-title text-5xl leading-none text-white/10 sm:text-6xl"
          aria-hidden="true">{index}</span
        >
        <h2
          id={`title-${id}`}
          tabindex="-1"
          data-view-title
          class="section-title text-[clamp(2rem,9vw,4.5rem)] text-white"
        >
          {title}
        </h2>
      </div>
      <div class="role-line mt-3 h-[2px] w-28 sm:w-44" aria-hidden="true"></div>
    </div>

    <div class="mt-8 sm:mt-10">
      <slot />
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-2 border-t border-white/10 pt-4 text-center sm:flex-row sm:text-left"
    >
      <p class="hud-label">FIN DEL EXPEDIENTE // {site.callsign}</p>
      <p class="hud-label flex items-center gap-2">
        <span class="status-dot" aria-hidden="true"></span>
        {site.status}
      </p>
    </div>
  </div>
</section>
