---
import Icon from "./Icon.astro";
import { site } from "../data/portfolio";
---

<section class="hero" id="inicio">
  <div class="hero-photo">
    <img src={site.photoCutout} alt={`Retrato de ${site.name}`} width="1400" height="1377" loading="eager" fetchpriority="high" decoding="async" />
  </div>
  <div class="wrap">
    <div class="hero-text">
      <p class="hi">Hola, soy</p>
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="where">{site.tagline}</p>
      <div class="socials">
        <a class="ghost ink cv-btn" href={site.cv} download="CV_Giovanni_Medina.pdf"><Icon name="download" size={18} />Descargar CV</a>
        <a class="sq" href={`mailto:${site.email}`} aria-label="Correo"><Icon name="at" /></a>
        <a class="sq" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a>
      </div>
    </div>
  </div>
</section>
